# ─────────────────────────────────────────────────────────────────
# AI 多市場研究助理 (fin_chat_ai) — Environment Variables
# ─────────────────────────────────────────────────────────────────
# 使用方式: cp .env.example .env  並填入實際值（.env 已被 .gitignore 排除）。
# 結構對齊 ARCHITECTURE.md §6。標 ♻️ 的憑證可沿用姊妹專案 finflow_ai。
#
# ⚠️ 共用資源去衝突：pCloud / Supabase / Cloudflare 即使共用帳號，
#    也必須用「不同命名空間」避免蓋掉 finflow_ai 的資料：
#      - pCloud   → 不同 PCLOUD_REMOTE_ROOT
#      - Supabase → 同 project 可，但用本專案自己的表名（design §22）
#      - Cloudflare → 不同 Public Hostname
# ─────────────────────────────────────────────────────────────────


# ── App ─────────────────────────────────────────────────────────
APP_ENV=development
TZ=Asia/Taipei
LOG_LEVEL=info


# ── LLM 廣度召回層（Gemini + google_search；憲章 2.0.0 Principle I）────
# 此層只產「帶 source URL 的待查證線索」，不做分析/選股。
# 取得方式: https://aistudio.google.com/apikey
GEMINI_API_KEY=replace-me-with-gemini-api-key
GEMINI_MODEL=gemini-flash-latest         # 泛用/相容預設
GEMINI_MODEL_BRIEF=gemini-pro-latest      # 降級路徑的晨報模型（決策層失效時才用）
GEMINI_MODEL_QA=gemini-flash-latest       # 檢索/降級問答用 Flash latest（快又省）
GEMINI_MODEL_CLASSIFIER=gemini-flash-lite-latest  # 意圖分類（最便宜檔；刻意不用決策層模型）
ENABLE_INTENT_FILTER=true        # 非財務問題直接婉拒，省下大 prompt 與 grounding
ENABLE_GEMINI_EXPLICIT_CACHE=true   # Gemini cachedContents（僅降級路徑用）
GEMINI_CACHE_TTL_SECONDS=7200       # 明確快取 TTL；對齊「當日一份晨報」生命週期
# 每日全站總花費上限（晨報+問答）。語意是「一篇晨報 + 若干問答」，所以**必須大於單篇晨報成本**
# ——它一度是 30 而單篇要 38.58，加上晨報刻意不受 check_budget() 攔截（那只擋 /ask），
# 等於日上限對最大宗支出完全失效。它同時是「月餘額低於它就讓晨報降級」的門檻。
DAILY_COST_LIMIT_TWD=45
MONTHLY_COST_LIMIT_TWD=600       # 每月全站總花費上限（對齊後台預算）

# ── LLM 決策 + 查證層（spec 022-llm-tiering）────────────────────
# 吃 features + facts pack + 回測校準做推理選股，並用 web_fetch 逐條開啟召回層引用的
# URL 查證後才採信——Gemini 的 grounding 會有幻覺，無條件採信等於把幻覺洗成假事實。
# 取得方式: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=replace-me-with-anthropic-api-key
LLM_DECISION_PROVIDER=anthropic  # anthropic | gemini（gemini＝降級/A-B 對照用）
CLAUDE_MODEL_DECISION=claude-opus-5   # 晨報決策（品質優先，晨報是產品本體）
CLAUDE_MODEL_CHAT=claude-opus-5       # 問答；用量稀疏，需省錢可降 claude-sonnet-5
CLAUDE_EFFORT=high               # 問答用 low|medium|high|xhigh|max（thinking 深度）
# 晨報獨立一檔——**輸出端的成本主閥**。thinking token 以 output 費率計價（Opus 5 $25/MTok），
# 2026-08-07 實測 effort=high 跑出 output 32,236 tokens ≈ NT$25.8/篇＝決策成本的 70%。
# 三箭把 input 從 363k 壓到 914 之後，effort 才第一次成為主導變數（此前的比較被 facts 量混淆）。
# ⚠️ 不要改用 thinking disabled 省錢：Opus 5 關掉 thinking 會出現「工具呼叫被寫成純文字、
# 其實沒跑」與「<thinking> 標籤外洩」兩個靜默失效模式。要省就降 effort。
CLAUDE_BRIEF_EFFORT=medium
CLAUDE_MAX_TOKENS=32000          # thinking + 回答合計上限
# 連網查證工具用量上限＝成本閘門（憲章 II）。**遠比直覺貴**：server-side 工具迴圈跑在
# API 內部，每一輪都會把累積的對話重送一次；features JSON 約 55k tokens，所以「多查一頁」
# 的成本 ≈ 一頁內容 + 一次完整前綴重送。2026-08-06 實測 max_uses=12 跑出 NT$73.83/篇。
# 但也不能調太低——查到一半被切斷會產出「部分查證」的晨報，比不查證更糟。
# 2026-08-07 由 5/3 降到 3/2：實測連兩篇的 fact_checks 幾乎全是 unverifiable/contradicted，
# 這筆錢買到的是「證明線索不可信」——該修的是召回層的 URL 品質，不是多買幾次 fetch。
CLAUDE_BRIEF_FETCH_USES=3
CLAUDE_BRIEF_SEARCH_USES=2
CLAUDE_CHAT_FETCH_USES=4
CLAUDE_CHAT_SEARCH_USES=2
CLAUDE_FETCH_MAX_CONTENT_TOKENS=3000   # 單頁擷取上限（長報導會跟著每一輪重送）
# pause_turn 續跑上限（防無窮迴圈），也是「整份晨報壓在單次呼叫」的實際旋鈕：
# 每多一輪＝多一次完整輸出 + 一次前綴重讀。用報告 JSON 的 cost.tokens.rounds 監控。
CLAUDE_MAX_CONTINUATIONS=2
# ⚠️ 問答預設 false 是刻意的：快取寫入付 1.25×(5m)/2×(1h)、讀取才 0.1×，
# 5m 需 2 次、1h 需 3 次以上讀取才回本。chat 稀疏使用時開啟反而更貴。
# 只有觀察到「同一份晨報 5 分鐘內被問 ≥2 題」才值得開。
ENABLE_CLAUDE_PROMPT_CACHE=false
# 晨報**相反、預設開**：工具迴圈在單一請求內把同一個 ~55k 前綴重讀多輪，
# 寫一次 1.25× 之後每輪讀 0.1×，正好打在成本主體上。同一條規則、相反的結論——
# 差別只在「同一份前綴會被讀幾次」。
ENABLE_CLAUDE_BRIEF_PROMPT_CACHE=true
CLAUDE_CACHE_TTL=5m              # 5m | 1h
ENABLE_FACTS_PACK=true           # 關閉＝退回純 Gemini 舊路徑

# 管理端點權杖。用途：①保護 /admin/*（成本校準 /admin/cost/calibrate）
# ②/ask 測試放行——帶 X-Admin-Token 時跳過每日上限但**花費照常計入**（壓測/驗證用）。
# 留空＝停用 /admin 端點且 /ask 不放行（fail-closed）。呼叫時帶 X-Admin-Token 標頭。
# 產生：python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=


# ── Discord（互動式 bot；1 guild / 3 channels / 2 users）─────────
# ⚠️ 取得 Bot Token：Developer Portal → 你的 App → "Bot" 分頁 → Reset Token → Copy。
#    這是 3 段點號分隔、約 70 字元（如 MTI3...xyz.Gabc.def...）。
#    **不是** OAuth2 → General 的 Client Secret（64 字元、無點號）—— 別貼錯！
#    另需在 Bot 分頁開啟 "MESSAGE CONTENT INTENT"。
DISCORD_TOKEN=replace-me-with-discord-bot-token
DISCORD_GUILD_ID=replace-me-with-guild-id
DISCORD_DAILY_REPORT_CHANNEL_ID=  # 每日晨報廣播頻道（兩人都看）
DISCORD_JAY_CHAT_CHANNEL_ID=      # Jay 專屬互動頻道
DISCORD_HANK_CHAT_CHANNEL_ID=     # Hank 專屬互動頻道
DISCORD_JAY_USER_ID=
DISCORD_HANK_USER_ID=


# ── 資料源 ──────────────────────────────────────────────────────
# FinMind 免費版 600 req/hr，必過 rate_limiter。取得: https://finmindtrade.com
FINMIND_TOKEN=replace-me-with-finmind-token   # ♻️ 可沿用 finflow
# 每小時請求硬上限（跨 process 用 Redis 計數，超過讓慢爬退避）。留安全邊際，預設 550。0＝關閉。
FINMIND_HOURLY_BUDGET=550
# 全市場財報慢爬「靜默窗」：此區間慢爬暫停、把 FinMind 整點額度讓給晨報。
# 預設「連動」PREFETCH_TIMES/REPORT_TIMES 自動推算（最早晨報活動前 LEAD 分、最晚後 TAIL 分），
# 改了晨報時間就會自動跟著調，不必手動同步。下列兩個是推算用的緩衝（分鐘）：
CRAWL_BLACKOUT_LEAD_MIN=60
CRAWL_BLACKOUT_TAIL_MIN=40
# 只有想手動釘死靜默窗時才填（非空＝覆寫上面的自動推算）；平常留空即可。
# FUNDAMENTALS_CRAWL_BLACKOUT=06:30-09:00
ENABLE_TWSE=true
ENABLE_TPEX=true
ENABLE_FINMIND=true
ENABLE_YAHOO=true
# Google Finance 個股頁新聞作第二來源（與 FinMind 並行去重合併）。無官方 API 靠爬 HTML、
# 有 ToS/封鎖風險，預設關；想啟用第二新聞來源再設 true。
ENABLE_GOOGLE_FINANCE_NEWS=false


# ── 儲存（local parquet SSOT，無 Postgres）─────────────────────
# 容器內 runtime 資料路徑；用 /data 避免蓋掉 /app/storage 這個 Python 套件
LOCAL_STORAGE_PATH=/data
LOCAL_STORAGE_BUDGET_GB=10       # 可調，對應 storage_monitor
REDIS_URL=redis://redis:6379/0


# ── Supabase（暖層 index；♻️ 可沿用，但用本專案自己的表）───────
# 取得方式: Supabase Dashboard → Project Settings → API
SUPABASE_URL=replace-me-with-supabase-url
SUPABASE_ANON_KEY=replace-me-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-me-with-supabase-service-role-key


# ── pCloud（冷儲存；♻️ 可沿用，但用不同 REMOTE_ROOT）──────────
# 取得方式: scripts/get_pcloud_token.py 跑 OAuth flow
PCLOUD_CLIENT_ID=replace-me-with-pcloud-client-id
PCLOUD_CLIENT_SECRET=replace-me-with-pcloud-client-secret
PCLOUD_ACCESS_TOKEN=replace-me-with-pcloud-access-token
PCLOUD_REGION=us                 # eu 或 us（看你註冊在哪台 server）
PCLOUD_REMOTE_ROOT=/AI-Market-Research   # ⚠️ 與 finflow 不同 root，勿共用


# ── Web / Cloudflare（認證走 Cloudflare Access）─────────────────
# 取得方式: Zero Trust → Networks → Tunnels → 建立 tunnel 後複製 token
# 建議本專案開新 tunnel/hostname，勿與 finflow 共用
CLOUDFLARE_TUNNEL_TOKEN=replace-me-with-cloudflare-tunnel-token
PUBLIC_HOSTNAME=report.your-domain.com         # ⚠️ 與 finflow hostname 不同
PUBLIC_REPORT_BASE_URL=https://report.your-domain.com
# 認證改用 Cloudflare Access（家庭成員 email allowlist），
# 不需 WEB_REPORT_USERNAME / WEB_REPORT_PASSWORD


# ── 排程 ────────────────────────────────────────────────────────
SCHEDULE_TZ=Asia/Taipei
# 自動產生報告的時間點（逗號分隔 HH:MM，時區同 SCHEDULE_TZ）。
# 單一時間：08:30；多時段範例（盤前+台股盤後+美股盤前）：08:30,14:00,21:30
# 成本：每篇約 NT$7.7、每月約 21 交易日 → 1次/日≈NT$160、2次≈NT$320、3次≈NT$480
# （沿用舊變數 MORNING_REPORT_TIME 仍可運作；未設 REPORT_TIMES 時自動 fallback）
REPORT_TIMES=08:30
# （可選）基本面預抓時間點，逗號分隔 HH:MM；留空＝關閉。設在 REPORT_TIMES 之前可暖磁碟快取、
# 讓晨報幾乎不打 FinMind、分散用量。例：PREFETCH_TIMES=07:30。財報本來就會落地（季更/月更），不設也行。
PREFETCH_TIMES=
# （可選）全市場財報「慢爬」時間點，逗號分隔 HH:MM；留空＝關閉。觸發後背景慢慢掃全市場(2700+)
# 財報到磁碟（焦點股優先），可數小時～23h；財報季更慢資料，靠快取 TTL 可重入續跑（中斷沒關係）。
# 機器若長時間開著想讓財報慢慢長滿，設例如 CRAWL_TIMES=09:00。待機/省電用法則留空、需要時手動跑。
CRAWL_TIMES=
# （可選）歷史行情「慢爬」——把 parquet 歷史拉長以餵大 edge 訓練集（不影響晨報）：
#   HISTORY_CRAWL_TIMES：軌道 A 上市歷史（TWSE 單日端點，不打 FinMind）。逗號分隔 HH:MM，建議深夜一晚（約 40 分跑完 2 年）。留空＝關閉。
#   HISTORY_TPEX_HOURLY_MIN：軌道 B 上櫃個股價（FinMind per-stock，每小時小批、嚴守額度不擾晨報）。填每小時的「分鐘」0-59（例 20＝每小時 :20）。留空＝關閉。
HISTORY_CRAWL_TIMES=
HISTORY_TPEX_HOURLY_MIN=
# （可選）基本面磁碟快取 TTL（天）。預設：月營收 7、季財報 30。通常不用改。
# FUNDAMENTALS_REVENUE_TTL_DAYS=7
# FUNDAMENTALS_FINANCIALS_TTL_DAYS=30
