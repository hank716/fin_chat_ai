# ─────────────────────────────────────────────────────────────────
# AI 多市場研究助理 (fin_chat_ai) — Environment Variables
# ─────────────────────────────────────────────────────────────────
# 使用方式: cp .env.example .env  並填入實際值（.env 已被 .gitignore 排除）。
# 結構對齊 ARCHITECTURE.md §6。標 ♻️ 的憑證可沿用姊妹專案 finflow_ai。
#
# ⚠️ 共用資源去衝突：pCloud / Supabase / Cloudflare 即使共用帳號，
#    也必須用「不同命名空間」避免蓋掉 finflow_ai 的資料：
#      - pCloud   → 不同 PCLOUD_REMOTE_ROOT
#      - Supabase → 同 project 可，但用本專案自己的表名（design §22）
#      - Cloudflare → 不同 Public Hostname
# ─────────────────────────────────────────────────────────────────


# ── App ─────────────────────────────────────────────────────────
APP_ENV=development
TZ=Asia/Taipei
LOG_LEVEL=info


# ── LLM（Gemini-only；系統內唯一 LLM，不接 Claude API）──────────
# 取得方式: https://aistudio.google.com/apikey
GEMINI_API_KEY=replace-me-with-gemini-api-key
GEMINI_MODEL=gemini-flash-latest         # 泛用/相容預設
GEMINI_MODEL_BRIEF=gemini-pro-latest      # 每日晨報用 PRO latest（品質優先，較貴）
GEMINI_MODEL_QA=gemini-flash-latest       # 平日問答用 Flash latest（快又省）
DAILY_COST_LIMIT_TWD=30          # 每日全站總花費上限（晨報+問答）
MONTHLY_COST_LIMIT_TWD=600       # 每月全站總花費上限（對齊 Google 後台預算）


# ── Discord（互動式 bot；1 guild / 3 channels / 2 users）─────────
# ⚠️ 取得 Bot Token：Developer Portal → 你的 App → "Bot" 分頁 → Reset Token → Copy。
#    這是 3 段點號分隔、約 70 字元（如 MTI3...xyz.Gabc.def...）。
#    **不是** OAuth2 → General 的 Client Secret（64 字元、無點號）—— 別貼錯！
#    另需在 Bot 分頁開啟 "MESSAGE CONTENT INTENT"。
DISCORD_TOKEN=replace-me-with-discord-bot-token
DISCORD_GUILD_ID=replace-me-with-guild-id
DISCORD_DAILY_REPORT_CHANNEL_ID=  # 每日晨報廣播頻道（兩人都看）
DISCORD_JAY_CHAT_CHANNEL_ID=      # Jay 專屬互動頻道
DISCORD_HANK_CHAT_CHANNEL_ID=     # Hank 專屬互動頻道
DISCORD_JAY_USER_ID=
DISCORD_HANK_USER_ID=


# ── 資料源 ──────────────────────────────────────────────────────
# FinMind 免費版 600 req/hr，必過 rate_limiter。取得: https://finmindtrade.com
FINMIND_TOKEN=replace-me-with-finmind-token   # ♻️ 可沿用 finflow
ENABLE_TWSE=true
ENABLE_TPEX=true
ENABLE_FINMIND=true
ENABLE_YAHOO=true


# ── 儲存（local parquet SSOT，無 Postgres）─────────────────────
# 容器內 runtime 資料路徑；用 /data 避免蓋掉 /app/storage 這個 Python 套件
LOCAL_STORAGE_PATH=/data
LOCAL_STORAGE_BUDGET_GB=10       # 可調，對應 storage_monitor
REDIS_URL=redis://redis:6379/0


# ── Supabase（暖層 index；♻️ 可沿用，但用本專案自己的表）───────
# 取得方式: Supabase Dashboard → Project Settings → API
SUPABASE_URL=replace-me-with-supabase-url
SUPABASE_ANON_KEY=replace-me-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-me-with-supabase-service-role-key


# ── pCloud（冷儲存；♻️ 可沿用，但用不同 REMOTE_ROOT）──────────
# 取得方式: scripts/get_pcloud_token.py 跑 OAuth flow
PCLOUD_CLIENT_ID=replace-me-with-pcloud-client-id
PCLOUD_CLIENT_SECRET=replace-me-with-pcloud-client-secret
PCLOUD_ACCESS_TOKEN=replace-me-with-pcloud-access-token
PCLOUD_REGION=us                 # eu 或 us（看你註冊在哪台 server）
PCLOUD_REMOTE_ROOT=/AI-Market-Research   # ⚠️ 與 finflow 不同 root，勿共用


# ── Web / Cloudflare（認證走 Cloudflare Access）─────────────────
# 取得方式: Zero Trust → Networks → Tunnels → 建立 tunnel 後複製 token
# 建議本專案開新 tunnel/hostname，勿與 finflow 共用
CLOUDFLARE_TUNNEL_TOKEN=replace-me-with-cloudflare-tunnel-token
PUBLIC_HOSTNAME=report.your-domain.com         # ⚠️ 與 finflow hostname 不同
PUBLIC_REPORT_BASE_URL=https://report.your-domain.com
# 認證改用 Cloudflare Access（家庭成員 email allowlist），
# 不需 WEB_REPORT_USERNAME / WEB_REPORT_PASSWORD


# ── 排程 ────────────────────────────────────────────────────────
SCHEDULE_TZ=Asia/Taipei
# 自動產生報告的時間點（逗號分隔 HH:MM，時區同 SCHEDULE_TZ）。
# 單一時間：08:30；多時段範例（盤前+台股盤後+美股盤前）：08:30,14:00,21:30
# 成本：每篇約 NT$7.7、每月約 21 交易日 → 1次/日≈NT$160、2次≈NT$320、3次≈NT$480
# （沿用舊變數 MORNING_REPORT_TIME 仍可運作；未設 REPORT_TIMES 時自動 fallback）
REPORT_TIMES=08:30
# （可選）基本面預抓時間點，逗號分隔 HH:MM；留空＝關閉。設在 REPORT_TIMES 之前可暖磁碟快取、
# 讓晨報幾乎不打 FinMind、分散用量。例：PREFETCH_TIMES=07:30。財報本來就會落地（季更/月更），不設也行。
PREFETCH_TIMES=
# （可選）全市場財報「慢爬」時間點，逗號分隔 HH:MM；留空＝關閉。觸發後背景慢慢掃全市場(2700+)
# 財報到磁碟（焦點股優先），可數小時～23h；財報季更慢資料，靠快取 TTL 可重入續跑（中斷沒關係）。
# 機器若長時間開著想讓財報慢慢長滿，設例如 CRAWL_TIMES=09:00。待機/省電用法則留空、需要時手動跑。
CRAWL_TIMES=
# （可選）基本面磁碟快取 TTL（天）。預設：月營收 7、季財報 30。通常不用改。
# FUNDAMENTALS_REVENUE_TTL_DAYS=7
# FUNDAMENTALS_FINANCIALS_TTL_DAYS=30
